# ─────────────────────────────────────────────────────────────
# BullMonk Trading Platform — Environment Configuration
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit the actual .env file to source control.
# ─────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────
APP_NAME=BullMonk Trading Platform
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# ── Infrastructure ────────────────────────────────────────────
# PostgreSQL: postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_URL=

# Redis: redis://localhost:6379/0
REDIS_URL=

# ── Security ─────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# ── Dhan (Indian Broker) ──────────────────────────────────────
# https://api.dhan.co/
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# ── Zerodha / Kite (Future) ───────────────────────────────────
ZERODHA_API_KEY=
ZERODHA_ACCESS_TOKEN=

# ── Upstox (Future) ──────────────────────────────────────────
UPSTOX_API_KEY=
UPSTOX_ACCESS_TOKEN=

# ── Fyers (Future) ───────────────────────────────────────────
FYERS_APP_ID=
FYERS_ACCESS_TOKEN=

# ── Binance (Future) ─────────────────────────────────────────
BINANCE_API_KEY=
BINANCE_SECRET=

# ── Risk Defaults ────────────────────────────────────────────
DEFAULT_MAX_DAILY_LOSS_PCT=3.0
DEFAULT_MAX_DRAWDOWN_PCT=15.0
DEFAULT_MAX_OPEN_POSITIONS=5
